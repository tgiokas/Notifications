EMAIL_PROVIDER=smtp
DMS_STORAGE_URL=http://storage-service:8080
#Must stay at or below StorageService's 40 MB per-object upload cap
ATTACHMENT_MAX_TOTAL_BYTES=26214400

# SendGrid Configuration
SENDGRID_API_KEY=sendgridkey
SENDGRID_FROM_EMAIL=giokasp@cbs.gr
SENDGRID_FROM_NAME=Archium

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=giokaspan@gmail.com
SMTP_PASSWORD=nhcvhgvsomperylp
SMTP_FROM=no-reply@example.com

# Outbox Configuration — used by the REST email endpoint (EmailsController).
# Requests submitted there are written here and delivered by OutboxProcessor.
OUTBOX_CONNECTION_STRING=Host=localhost;Port=5432;Database=notifications;Username=notifications;Password=notifications
OUTBOX_POLLING_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=5

# Kafka Configuration — unrelated to the REST endpoint. KafkaEmailConsumer
# consumes whatever external producers publish onto these topics.
# Set KAFKA_ENABLED=false in environments with no Kafka broker at all — the
# consumer is skipped (the vars below are then ignored) and the REST/outbox
# endpoint is unaffected. Defaults to true.
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
NOTIFY_KAFKA_RECONNECT_BACKOFF_MS=50
NOTIFY_KAFKA_RECONNECT_BACKOFF_MAX_MS=10000
NOTIFY_KAFKA_SOCKET_CONNECTION_SETUP_TIMEOUT_MS=10000
NOTIFY_KAFKA_SOCKET_TIMEOUT_MS=30000

# Kafka Consumer Configuration
NOTIFY_KAFKA_TOPICS=notifications.email.auth,notifications.email.backend, notifications.email.citizen
NOTIFY_KAFKA_GROUP_ID=email-consumers
NOTIFY_KAFKA_AUTO_OFFSET_RESET=Earliest
NOTIFY_KAFKA_SESSION_TIMEOUT_MS=30000
NOTIFY_KAFKA_MAX_POLL_INTERVAL_MS=300000